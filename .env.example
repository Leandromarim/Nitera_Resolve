# ==== NITERA Resolve — copie para .env e preencha (o deploy/instalar.sh faz isso sozinho) ====
# Domínio onde o sistema vai responder (precisa apontar para este servidor).
# Só pela rede interna, sem domínio: SITE_ADDRESS=:80 e PUBLIC_URL=http://IP-DO-SERVIDOR
SITE_ADDRESS=chamados.exemplo.com.br
PUBLIC_URL=https://chamados.exemplo.com.br

# Banco (gere uma senha forte)
POSTGRES_PASSWORD=

# Segredos — gere cada um com: openssl rand -base64 48
JWT_ACCESS_SECRET=
HASH_PEPPER=

# false só quando o acesso é por http (sem HTTPS)
COOKIE_SECURE=true
# tamanho máximo de cada anexo (MB)
MAX_UPLOAD_MB=25

# Nome da instituição nas telas e nos e-mails (dá para mudar depois em Instituição e aparência)
INSTITUICAO_NOME='Minha Instituição'

# ---- WhatsApp Cloud API (Meta): abertura e acompanhamento de chamados pelo WhatsApp ----
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Template aprovado na Meta para mensagens fora da janela de 24h (opcional)
WHATSAPP_TEMPLATE_UPDATE=

# ---- E-mail: avisos dos chamados, "Esqueci minha senha" e abertura de chamados por e-mail ----
EMAIL_ENABLED=false
# caixa lida para abrir chamados por e-mail (vazio = não lê e-mails)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_USER=suporte@exemplo.com.br
SMTP_PASSWORD=
SMTP_FROM="Suporte <suporte@exemplo.com.br>"
# Microsoft 365: a Microsoft desativou senha em IMAP/SMTP. Preencha estes três (aplicativo no Entra ID)
# e deixe IMAP_PASSWORD/SMTP_PASSWORD vazios. Veja docs/IMPLANTACAO.md.
MAIL_OAUTH_TENANT=
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
