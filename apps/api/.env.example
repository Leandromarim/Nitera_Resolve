# Desenvolvimento local da API (no servidor, use o .env da raiz gerado por deploy/instalar.sh).
# Copie para apps/api/.env e preencha. Nunca envie o .env para o repositório.
PORT=4200
NODE_ENV=development
DATABASE_URL=postgresql://resolve:troque-esta-senha@localhost:5432/resolve_dev

# Segredos — gere cada um com: openssl rand -base64 48
JWT_ACCESS_SECRET=
HASH_PEPPER=

PUBLIC_URL=http://localhost:3200
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
INSTITUICAO_NOME="Minha Instituição"

# WhatsApp Cloud API (Meta) — opcional
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# E-mail — opcional
EMAIL_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Suporte <suporte@suaempresa.com.br>"
